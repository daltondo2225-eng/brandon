# Anthropic API key - get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Local API key the Electron client uses to authenticate to the Brandon server.
# Generate any random string; the client reads it from this same file.
BRANDON_API_KEY=change-me-to-a-random-string

# Port the Brandon server listens on. Leave unset to let the OS pick a free
# port automatically (recommended). The desktop shell discovers the chosen
# port from server/data/brandon-port at startup.
# PORT=8787

# Optional: enable Anthropic's 1h extended cache TTL beta (saves cost during quiet stretches)
BRANDON_EXTENDED_CACHE=true
