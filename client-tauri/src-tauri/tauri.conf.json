{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brandon",
  "version": "0.1.0",
  "identifier": "com.brandon.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Brandon",
        "url": "main/index.html",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "visible": true,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Brandon Overlay",
        "url": "overlay/index.html",
        "width": 560,
        "height": 460,
        "minWidth": 420,
        "minHeight": 320,
        "x": 680,
        "y": 24,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://api.open-meteo.com https://geocoding-api.open-meteo.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin": "bin",
      "server": "server"
    },
    "copyright": "Copyright (c) 2026 Brandon",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
